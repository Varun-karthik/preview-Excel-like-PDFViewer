<mvc:View
    xmlns:unified="sap.ui.unified"
    controllerName="excelpreview.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:core="sap.ui.core"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <u:FileUploader
            id="fileUploader"
            name="myFileUpload"
            uploadUrl="upload/"
            fileAllowed="xlsx"
            tooltip="Upload your file to the local server"/>
            <!-- uploadComplete=".handleUploadComplete"
        /> -->
        <Button
            id="uploadButton"
            text="Upload File"
            press=".handleUploadPress"
        />
        <Button
            id="previewButton"
            text="Preview File"
            press=".handlePreviewPress"
        />

        <VBox id="vbox1" >
            <Text id="text" text="Hello Below is the Excel Uploaded"></Text>
            <!-- Container injected for Handsontable rendering -->
            <core:HTML id="excelPreviewContainer" content='&lt;div id="hot-container" style="width: 100%; height: 400px; overflow: hidden;"&gt;&lt;/div&gt;' />
        </VBox>
    </Page>
</mvc:View>
